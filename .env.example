# GEMINI_API_KEY: Server-side only secret for Gemini API calls.
# Never expose this key to client bundle via Vite define/VITE_*.
# Keep this value only in backend runtime secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server-side proxy port.
PORT="8787"

# Security monitoring thresholds (Phase 4)
SECURITY_TRAFFIC_WINDOW_MS="60000"
SECURITY_TRAFFIC_THRESHOLD="120"
SECURITY_ERROR_THRESHOLD="25"
SECURITY_ALERT_COOLDOWN_MS="300000"
# Optional: webhook endpoint to receive security alerts
SECURITY_ALERT_WEBHOOK_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
